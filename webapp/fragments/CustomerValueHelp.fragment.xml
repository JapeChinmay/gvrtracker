<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="CustomerVHD"
        title="Select:Mobile No"
        contentWidth="100%"
    >
        <VBox  width="100%">
            <HBox
                justifyContent="End"
                
                alignItems="Center"
            >
                <SearchField
                    class="sapUiTinyMarginBegin"
                    width="80%"
                    placeholder="search"
                    search="onCustomerSearch"
                />

                <layoutData>
                    <FlexItemData growFactor="7" />
                </layoutData>

                <Button
                    text="Go"
                    type="Emphasized"
                    press="onCustomerSearch"
                />

                <layoutData>
                    <FlexItemData growFactor="1" />
                </layoutData>

                <Button
                    text="Hide Filters"
                    type="Transparent"
                >
                    <layoutData>
                        <FlexItemData growFactor="2" />
                    </layoutData>
                </Button>
            </HBox>

            <Title
                text="Items"
                level="H4"
                class="sapUiMediumMarginTop"
            />

            <Table
                id="customerTable"
                items="{/CustomerSet}"
            >
                <columns>
                    <Column>
                        <Text text="Mobile Number" />
                    </Column>

                    <Column>
                        <Text text="Customer Name" />
                    </Column>

                    <Column>
                        <Text text="Customer Email" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem
                        type="Active"
                        press="onCustomerSelect"
                    >
                        <cells>
                            <Text text="{phone}" />
                            <Text text="{name}" />
                            <Text text="{email}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>

        <endButton>
            <Button
                text="Cancel"
                press="onCustomerDialogClose"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
