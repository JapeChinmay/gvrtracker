<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="Select:Campaign"
        contentWidth="100%"
    >
        <VBox width="100%">
            <HBox
                alignItems="Center"
                justifyContent="SpaceBetween"
                width="100%"
            >
                <SearchField
                    width="80%"
                    placeholder="Search"
                    search="onCampaignSearch"
                    class="sapUiTinyMarginBegin"
                />
                <Button
                    text="GO"
                    type="Emphasized"
                    press="onCampaignSearch"
                    class="sapUiTinyMarginEnd"
                />
            </HBox>

            <Title
                text="Items"
                level="H4"
                class="sapUiTinyMarginBegin"
            />

            <List
                items="{ 
        path:   '/MallCampaignSet' 
        
        
         }"
                mode="SingleSelectMaster"
                selectionChange="onSelectionChange"
            >
                <StandardListItem title="{name}" />
            </List>
        </VBox>

        <endButton>
            <Button
                text="Cancel"
                press="onCampaignCancel"
            />
        </endButton>
        
    </Dialog>
</core:FragmentDefinition>
