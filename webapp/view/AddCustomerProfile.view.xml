<mvc:View
    controllerName="gvtracker.controller.AddCustomerProfile"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page
        title="Gift Voucher Tracker - Mall Customer Profile"
        showNavButton="false">

        <headerContent>
            <Button
                text="Home"
                icon="sap-icon://home"
                type="Transparent"
                press="onCancel"
                class="gvt-btn gvt-btn--ghost"/>
        </headerContent>

        <content>

       
            <VBox alignItems="Center" class="sapUiMediumMarginTop">

           
                <VBox
                    width="560px"
                    style="
                        background: #ffffff;
                        border: 1px solid #e8eaed;
                        border-radius: 16px;
                        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
                        overflow: hidden;">

                  
               

                 
                    <VBox style="padding: 24px 28px 20px;">

                  
                        <VBox class="sapUiSmallMarginBottom">
                            <Label
                                text="Mobile Number"
                                required="true"
                                style="font-weight: 600; color: #3c4043; margin-bottom: 4px;"/>
                            <Input
                                value="{customer>/phone}"
                                width="100%"
                                maxLength="10"
                                type="Number"
                                placeholder="Enter 10-digit mobile number"/>
                        </VBox>

                   
                        <VBox class="sapUiSmallMarginBottom">
                            <Label
                                text="Mobile Country Code"
                                style="font-weight: 600; color: #3c4043; margin-bottom: 4px;"/>
                            <Select
                                width="100%"
                                items="{/CountryCodes}"
                                selectedKey="{customer>/phoneCode_code}">
                                <core:Item key="{code}" text="{code}"/>
                            </Select>
                        </VBox>

                  
                        <HBox alignItems="Start" class="sapUiSmallMarginBottom">

                            <VBox width="160px" class="sapUiSmallMarginEnd">
                                <Label
                                    text="Title"
                                    required="true"
                                    style="font-weight: 600; color: #3c4043; margin-bottom: 4px;"/>
                                <Select
                                    width="100%"
                                    items="{/Salutations}"
                                    selectedKey="{customer>/salutation_code}">
                                    <core:Item key="{code}" text="{name}"/>
                                </Select>
                            </VBox>

                            <VBox class="sapUiSmallMarginEnd" style="flex: 1;">
                                <Label
                                    text="Customer Name"
                                    required="true"
                                    style="font-weight: 600; color: #3c4043; margin-bottom: 4px;"/>
                                <Input
                                    value="{customer>/name}"
                                    width="100%"
                                    placeholder="Enter full name"/>
                            </VBox>

                        </HBox>

                
                        <VBox class="sapUiSmallMarginBottom">
                            <Label
                                text="Email Address"
                                style="font-weight: 600; color: #3c4043; margin-bottom: 4px;"/>
                            <Input
                                value="{customer>/email}"
                                width="100%"
                                type="Email"
                                placeholder="customer@example.com"/>
                        </VBox>

                      
                        <core:HTML content="&lt;div style='border-top: 1px solid #f1f3f4; margin: 16px 0 20px;'&gt;&lt;/div&gt;"/>

               
                        <HBox justifyContent="End" alignItems="Center">
                            <Button
                                text="Cancel"
                                type="Transparent"
                                press="onCancel"
                                class="gvt-btn gvt-btn--danger sapUiSmallMarginEnd"/>
                            <Button
                                text="Add Customer"
                                type="Emphasized"
                                icon="sap-icon://add"
                                press="onAddCustomer"
                                class="gvt-btn gvt-btn--primary"/>
                        </HBox>

                    </VBox>
                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>