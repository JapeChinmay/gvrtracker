<mvc:View
    controllerName="gvtracker.controller.HomeScreen"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page
        id="page"
        title="Gift Voucher Tracker"
        showNavButton="false">

        <headerContent>
            <Button
                icon="sap-icon://person-placeholder"
                text="User Profile"
                type="Transparent"/>
        </headerContent>

        <content>

        
            <VBox
                class="sapUiMediumMarginTop sapUiMediumMarginBottom"
                alignItems="Center">
                <core:Icon
                    src="sap-icon://gift"
                    size="3rem"
                    color="@sapUiHighlight"
                    class="sapUiSmallMarginBottom"/>
                <Title
                    text="Gift Voucher Activity"
                    level="H2"
                    class="sapUiSmallMarginBottom"/>
                <Text
                    text="Select an activity mode and execute to proceed"
                    class="sapUiSmallMarginBottom"/>
            </VBox>

  
            <VBox alignItems="Center">
                <Panel
                    width="520px"
                    expandable="false"
                    class="sapUiMediumMarginBottom">

                    <headerToolbar>
                        <Toolbar>
                            <core:Icon src="sap-icon://action-settings" class="sapUiSmallMarginBegin"/>
                            <Title text="Activity Selection" level="H4" class="sapUiSmallMarginBegin"/>
                        </Toolbar>
                    </headerToolbar>

                    <content>
                        <VBox class="sapUiMediumMargin">

                     
                            <f:SimpleForm
                                layout="ResponsiveGridLayout"
                                columnsXL="1"
                                columnsL="1"
                                columnsM="1"
                                editable="false"
                                class="sapUiNoMargin">
                                <f:content>
                                    <Label text="Activity Mode :" design="Bold"/>
                                    <RadioButtonGroup
                                        id="modeSelect"
                                        selectedIndex="0"
                                        columns="4"
                                        select="onModeSelect">
                                        <buttons>
                                            <RadioButton text="CREATE"/>
                                            <RadioButton text="RETURN"/>
                                            <RadioButton text="REPLACEMENT"/>
                                            <RadioButton text="DISPLAY"/>
                                        </buttons>
                                    </RadioButtonGroup>
                                </f:content>
                            </f:SimpleForm>

                            <core:HTML content="&lt;div style='border-top: 1px solid #e0e0e0; margin: 12px 0;'&gt;&lt;/div&gt;"/>

                            <f:SimpleForm
                                layout="ResponsiveGridLayout"
                                columnsXL="1"
                                columnsL="1"
                                columnsM="1"
                                editable="false"
                                class="sapUiNoMargin">
                                <f:content>
                                    <Label text="GVR Number :" design="Bold"/>
                                    <HBox alignItems="Center">
                                        <Input
                                            id="GVRInput"
                                            width="300px"
                                            placeholder="Not required for CREATE"
                                            enabled="false"
                                            showValueHelp="true"
                                            valueHelpRequest="onGVRValueHelp"
                                            valueLiveUpdate="true"/>
                                    </HBox>
                                </f:content>
                            </f:SimpleForm>

                            <core:HTML content="&lt;div style='border-top: 1px solid #e0e0e0; margin: 12px 0;'&gt;&lt;/div&gt;"/>

                     
                            <HBox justifyContent="End">
                                <Button
                                    text="Execute"
                                    type="Emphasized"
                                    icon="sap-icon://play"
                                    press="OnExecute"
                                    width="150px"/>
                            </HBox>

                        </VBox>
                    </content>
                </Panel>

