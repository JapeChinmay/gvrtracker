        </content>

        <footer>
            <Toolbar>
                <Text text="Shopping Mall : 8208" class="sapUiSmallMarginBegin"/>
                <ToolbarSpacer/>
                <Text text="Gift Voucher Tracker v1.0" class="sapUiSmallMarginEnd"/>
            </Toolbar>
