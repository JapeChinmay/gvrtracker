<mvc:View
    controllerName="gvtracker.controller.CreateScreen"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="Gift Voucher Tracker - Gift Issue to Customer Activity">

        <headerContent class="sapMPageHeader" >
            <Button text="Home" icon="sap-icon://home" press="onHome"/>
        </headerContent>

        <content>
            <VBox class="sapUiSmallMargin">

     
                <HBox alignItems="Start" wrap="Wrap" class="sapUiSmallMarginBottom">

                    <VBox class="sapUiSmallMarginEnd" width="220px">
                        <Label text="Shopping Mall" class="sapUiTinyMarginBottom"/>
                        <Text text="8208"/>
                    </VBox>

                    <VBox class="sapUiSmallMarginEnd" width="300px">
                        <Label text="Customer Type" class="sapUiTinyMarginBottom"/>
                        <Select width="100%" items="{path: '/CustTypes'}">
                            <core:Item key="{code}" text="{name}"/>
                        </Select>
                    </VBox>

                    <VBox class="sapUiSmallMarginEnd" width="300px">
                        <Label text="Employee ID / Name" class="sapUiTinyMarginBottom"/>
                        <Input value="102312" width="100%"/>
                    </VBox>

                    <VBox width="160px">
                        <Label text="GVR Date" class="sapUiTinyMarginBottom"/>
                        <Text id="GVRDate" text="09/03/2026"/>
                    </VBox>

                </HBox>

                <HBox alignItems="Start" wrap="Wrap" class="sapUiSmallMarginBottom">

                    <VBox class="sapUiSmallMarginEnd" width="220px">
                        <Label text="Total Assign Items Value" class="sapUiTinyMarginBottom"/>
                        <Text id="totalAssignValue" text="0.00"/>
                    </VBox>

                    <VBox class="sapUiSmallMarginEnd" width="300px">
                        <Label text="Customer Mobile *" required="true" class="sapUiTinyMarginBottom"/>
                        <Input
                            id="mobileCustomerInput"
                            placeholder="Enter mobile"
                            showValueHelp="true"
                            valueHelpRequest="onMobileValueHelp"
                            valueHelpIconSrc="sap-icon://copy"
                            liveChange="onMobileChange"
                            width="100%"/>
                    </VBox>

                    <VBox class="sapUiSmallMarginEnd" width="300px">
                        <Label text="Campaign *" required="true" class="sapUiTinyMarginBottom"/>
                        <Input
                            id="camPaignVlaueHelp"
                            placeholder="Campaign"
                            showValueHelp="true"
                            valueHelpRequest="onCampaignValueHelp"
                            width="100%"/>
                    </VBox>

                    <VBox width="220px" justifyContent="End">
                        <Button
                            id="addCustInfo"
                            text="Add Customer Profile"
                            width="100%"
                            class="sapUiTinyMarginBottom"
                            press="onAddCustomer"/>
                        <Button
                            id="custBillInfo"
                            text="Add Customer Bill Info"
                            width="100%"
                            enabled="false"
                            class="sapUiTinyMarginTop"
                            press="onAddCustomerBillInfo"/>
                    </VBox>

                </HBox>

                <HBox alignItems="Start" wrap="Wrap" class="sapUiSmallMarginBottom">
                    <VBox width="100%">
                        <Label text="Comments" class="sapUiTinyMarginBottom"/>
                        <TextArea
                            id="inputComments"
                            width="100%"
                            rows="2"/>
                    </VBox>
                </HBox>

           
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                    <Title text="Gift Item Details for Customer Issue" level="H4"/>
                    <SearchField
                        width="250px"
                        placeholder="Search"/>
                </HBox>

                <Table
                    id="giftTable"
                    inset="false"
                    growing="true"
                    growingScrollToLoad="true"
                    items="{/GiftVoucherSet}">
                    <columns>
                        <Column width="3rem"/>
                        <Column><Text text="Material Name"/></Column>
                        <Column><Text text="Description"/></Column>
                        <Column><Text text="Stock Qty"/></Column>
                        <Column><Text text="Price"/></Column>
                        <Column><Text text="Issue Qty"/></Column>
                        <Column><Text text="Coupon"/></Column>
                        <Column><Text text="Brand"/></Column>
                        <Column><Text text="Expiry Date"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <CheckBox
                                    selected="false"
                                    enabled="{= ${stock} > 0 }"
                                    select="onCheckBoxSelect"/>
                                <Text text="{material}"/>
                                <Text text="{descr}"/>
                                <Text text="{stock}"/>
                                <Text text="{price}"/>
                                <Input
                                    width="80px"
                                    value="1"
                                    enabled="{= ${stock} > 0 }"
                                    liveChange="onIssueItemChange"/>
                                <Text text="{coupon}"/>
                                <Text text="{brand}"/>
                                <Text text="{
                                    path: 'expDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { pattern: 'dd/MM/yyyy' }
                                }"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button text="Cancel" press="onCancel"/>
                <Button text="Submit" type="Emphasized"  class="gvt-btn gvt-btn--primary" press="onSubmit"/>
            </Toolbar>
        </footer>

    </Page>
</mvc:View>